#!/usr/bin/env bash
MONROE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$MONROE_ROOT/.venv/bin/activate"

export WANDB_PROJECT=monroe
# export WANDB_ENTITY=your-team

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

export TORCHINDUCTOR_CACHE_DIR="$MONROE_ROOT/.torch/inductor_cache"

# Accept the licence at https://ux.priorlabs.ai, key from /account.
export TABPFN_TOKEN=
# export TABPFN_MODEL_VERSION=v2
